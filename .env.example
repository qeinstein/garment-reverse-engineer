# ==============================================================================
# Garment Reverse Engineer — Environment Configuration Template
# Copy this file to `.env` or `.env.local` for local development.
# For Vercel deployment, configure these variables in the Vercel Project Dashboard.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Hugging Face ZeroGPU Space URL
# ------------------------------------------------------------------------------
# Variable: PUBLIC_HF_REWEAVER_SPACE_URL
# Scope: PUBLIC (Safe to expose to client-side browser)
# Where Used: apps/web (client connection) and scripts/smoke_hf_space.py
# Example: https://huggingface.co/spaces/qeinstein/reweaver-zero
# Required in Vercel: YES (if calling public HF Space directly)
# Required in HF Space: NO
PUBLIC_HF_REWEAVER_SPACE_URL=https://huggingface.co/spaces/your-username/reweaver-zero

# ------------------------------------------------------------------------------
# 2. Hugging Face User Access Token (ONLY required if Space is PRIVATE)
# ------------------------------------------------------------------------------
# Variable: HF_TOKEN
# Scope: SECRET (NEVER expose to browser, NEVER prefix with PUBLIC_ or NEXT_PUBLIC_)
# Where Used: Vercel serverless function (/api/reconstruct) and scripts/smoke_hf_space.py
# Permissions Required: Read permission only (created at https://huggingface.co/settings/tokens)
# Example: hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Required in Vercel: YES IF Space is Private, NO if Space is Public
# Required in HF Space: NO
# Can be exposed client-side: NO (Strictly Server-Only)
HF_TOKEN=

# ------------------------------------------------------------------------------
# 3. Reconstruction Transport Mode
# ------------------------------------------------------------------------------
# Variable: PUBLIC_RECONSTRUCTION_MODE
# Scope: PUBLIC
# Options:
#   - 'direct': Browser calls the public HF Space directly via @gradio/client (lowest latency, zero token)
#   - 'proxy': Browser calls Vercel serverless /api/reconstruct which forwards to HF using HF_TOKEN
# Default: direct
PUBLIC_RECONSTRUCTION_MODE=direct
